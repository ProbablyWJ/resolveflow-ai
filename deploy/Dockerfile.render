FROM node:22-alpine AS frontend

WORKDIR /frontend
COPY 前端/package*.json ./
RUN npm ci
COPY 前端/ ./
RUN npm run build
COPY deploy/runtime-config.js /frontend/dist/runtime-config.js


FROM python:3.12-slim AS dependencies

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY 后端/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# Cache the default Chroma embedding model during the image build so the first
# portfolio visitor does not wait for a runtime download.
RUN python - <<'PY'
import pathlib
import shutil
import tarfile
import urllib.request

url = "https://chroma-onnx-models.s3.amazonaws.com/all-MiniLM-L6-v2/onnx.tar.gz"
dest = pathlib.Path("/root/.cache/chroma/onnx_models/all-MiniLM-L6-v2")
dest.mkdir(parents=True, exist_ok=True)
archive = dest / "onnx.tar.gz"
with urllib.request.urlopen(url, timeout=60) as response, archive.open("wb") as target:
    shutil.copyfileobj(response, target)
with tarfile.open(archive, "r:gz") as bundle:
    bundle.extractall(dest)
archive.unlink()
PY


FROM python:3.12-slim AS production

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    RESOLVEFLOW_STATIC_DIR=/app/web

RUN useradd -m -u 1000 resolveflow
COPY --from=dependencies /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin
COPY --from=dependencies --chown=resolveflow:resolveflow /root/.cache/chroma /home/resolveflow/.cache/chroma
COPY --chown=resolveflow:resolveflow 后端/ /app/
COPY --from=frontend --chown=resolveflow:resolveflow /frontend/dist /app/web

RUN mkdir -p /app/data/chroma /app/data/eval /app/logs && \
    chown -R resolveflow:resolveflow /app/data /app/logs /app/web

USER resolveflow
EXPOSE 10000

CMD ["sh", "-c", "python -m uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-10000}"]
